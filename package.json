{
  "name": "pr-review",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pr-review": "./bin/pr-review.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "pr-review": "node bin/pr-review.mjs",
    "bench": "node bench/run.ts",
    "bench:compare": "node bench/compare.ts",
    "eval:snapshot": "node bench/real-snapshot.ts",
    "eval:real": "node bench/real-run.ts",
    "eval:report": "node bench/real-report.ts",
    "protocol:emit": "node src/protocol/emit.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "jev-systemone": "0.1.1",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
