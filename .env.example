# pr-review serve. Copy to .env and fill in; never commit the filled-in file.

# Webhook HMAC secret, the same value as in the GitHub App settings. Required.
GITHUB_WEBHOOK_SECRET=

# GitHub App auth. Set GITHUB_APP_ID and one of the two key variables.
# Without GITHUB_APP_ID, serve uses token auth from GITHUB_TOKEN instead.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GITHUB_TOKEN=
# With an installation token (ghs_...) as GITHUB_TOKEN, our reviews' author, so reconciliation can match them.
# PR_REVIEW_BOT_LOGIN=my-app[bot]

# Bearer token for /readyz, /reviews/* and /webhooks/dead. Unset means those endpoints always answer 401.
PR_REVIEW_ADMIN_TOKEN=

# Review model (provider/id) and its credential.
PR_REVIEW_MODEL=anthropic/claude-opus-5-5
ANTHROPIC_API_KEY=

# Optional. Without it, serve skips Jev and records the fallback route.
# TYPESAFE_API_KEY=

# Config file path. The default publish_mode is dry_run: serve records reviews but posts nothing until the file
# sets {"review": {"publish_mode": "comment"}}.
PR_REVIEW_CONFIG=/data/pr-review.config.json

PORT=8080
PR_REVIEW_DATA_DIR=/data
# GITHUB_API_URL=https://api.github.com
