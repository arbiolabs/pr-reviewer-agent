            },
            {
              "kind": "add",
              "new": 13,
              "text": "// RequestID reuses an inbound X-Request-ID or mints one, and attaches it to the request's logger."
            },
            {
              "kind": "add",
              "new": 14,
              "text": "func RequestID(next http.Handler) http.Handler {"
            },
            {
              "kind": "add",
              "new": 15,
              "text": "\treturn http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {"
            },
            {
              "kind": "add",
              "new": 16,
              "text": "\t\tid := r.Header.Get(\"X-Request-ID\")"
            },
            {
              "kind": "add",
              "new": 17,
              "text": "\t\tif id == \"\" || len(id) > 64 {"
            },
            {
              "kind": "add",
              "new": 18,
              "text": "\t\t\tid = uuid.NewString()"
            },
            {
              "kind": "add",
              "new": 19,
              "text": "\t\t}"
            },
            {
              "kind": "add",
              "new": 20,
              "text": "\t\tw.Header().Set(\"X-Request-ID\", id)"
            },
            {
              "kind": "add",
              "new": 21,
              "text": "\t\tlogger := slog.Default().With(\"request_id\", id)"
            },
            {
              "kind": "add",
              "new": 22,
              "text": "\t\tnext.ServeHTTP(w, r.WithContext(context.WithValue(r.Context(), ctxKey{}, logger)))"
            },
            {
              "kind": "add",
              "new": 23,
              "text": "\t})"
