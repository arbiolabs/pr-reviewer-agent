          "oldStart": 0,
          "newStart": 1,
          "lines": [
            {
              "kind": "add",
              "new": 1,
              "text": "import type { Db } from \"../deps.ts\";"
            },
            {
              "kind": "add",
              "new": 2,
              "text": ""
            },
            {
              "kind": "add",
              "new": 3,
              "text": "export const PAGE_SIZE = 20;"
            },
            {
              "kind": "add",
              "new": 4,
              "text": ""
            },
            {
              "kind": "add",
              "new": 5,
              "text": "export async function orderHistory(db: Db, customerId: string, page: number) {"
            },
            {
              "kind": "add",
              "new": 6,
              "text": "  const total = await db.order.count({ where: { customerId } });"
            },
            {
              "kind": "add",
              "new": 7,
              "text": "  const lastPage = Math.max(1, Math.ceil(total / PAGE_SIZE));"
            },
            {
              "kind": "add",
              "new": 8,
              "text": "  const orders = await db.order.findMany({"
            },
            {
              "kind": "add",
              "new": 9,
              "text": "    where: { customerId },"
            },
            {
              "kind": "add",
              "new": 10,
              "text": "    orderBy: { placedAt: \"desc\" },"
            },
            {
              "kind": "add",
              "new": 11,
              "text": "    skip: (page - 1) * PAGE_SIZE,"
            },
            {
              "kind": "add",
              "new": 12,
              "text": "    take: PAGE_SIZE,"
            },
            {
              "kind": "add",
              "new": 13,
              "text": "  });"
            },
            {
              "kind": "add",
              "new": 14,
              "text": ""
            },
            {
              "kind": "add",
              "new": 15,
              "text": "  const withItems = [];"
            },
            {
              "kind": "add",
              "new": 16,
              "text": "  for (const order of orders) {"
            },
            {
              "kind": "add",
              "new": 17,
              "text": "    const items = await db.orderItem.findMany({"
            },
            {
              "kind": "add",
              "new": 18,
              "text": "      where: { orderId: order.id },"
            },
            {
              "kind": "add",
              "new": 19,
              "text": "      include: { product: true },"
            },
            {
              "kind": "add",
              "new": 20,
              "text": "    });"
            },
            {
              "kind": "add",
              "new": 21,
              "text": "    withItems.push({ ...order, items });"
            },
            {
              "kind": "add",
              "new": 22,
              "text": "  }"
            },
            {
              "kind": "add",
              "new": 23,
              "text": ""
            },
            {
              "kind": "add",
              "new": 24,
              "text": "  return {"
            },
            {
              "kind": "add",
              "new": 25,
              "text": "    orders: withItems,"
            },
            {
              "kind": "add",
              "new": 26,
              "text": "    page,"
            },
            {
              "kind": "add",
              "new": 27,
              "text": "    lastPage,"
            },
            {
              "kind": "add",
              "new": 28,
              "text": "    hasNext: page <= lastPage,"
            },
            {
              "kind": "add",
              "new": 29,
              "text": "    hasPrev: page > 1,"
            },
            {
              "kind": "add",
              "new": 30,
              "text": "  };"
            },
            {
              "kind": "add",
              "new": 31,
              "text": "}"
            }
          ]
        }
      ],
