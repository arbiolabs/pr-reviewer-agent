            {
              "kind": "add",
              "new": 12,
              "text": ""
            },
            {
              "kind": "add",
              "new": 13,
              "text": "export async function releaseHold(db: Db, holdId: string) {"
            },
            {
              "kind": "add",
              "new": 14,
              "text": "  await db.hold.update({ where: { id: holdId }, data: { releasedAt: new Date() } });"
            },
            {
              "kind": "add",
