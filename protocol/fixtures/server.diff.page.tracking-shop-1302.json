              "text": "export async function onPaymentSucceeded(db: Db, event: PaymentEvent) {"
            },
            {
              "kind": "add",
              "new": 4,
              "text": "  const hold = await db.hold.findUnique({ where: { paymentIntentId: event.intentId } });"
            },
            {
              "kind": "add",
              "new": 5,
              "text": "  if (!hold) return;"
            },
            {
              "kind": "add",
              "new": 6,
              "text": "  await db.booking.create({ data: { slotId: hold.slotId, guestId: hold.guestId } });"
            },
            {
              "kind": "add",
              "new": 7,
              "text": "  await db.hold.delete({ where: { id: hold.id } });"
            },
