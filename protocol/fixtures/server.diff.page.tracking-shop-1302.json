            },
            {
              "kind": "add",
              "new": 3,
              "text": "export const HOLD_MINUTES = 10;"
            },
            {
              "kind": "add",
              "new": 4,
              "text": ""
            },
            {
              "kind": "add",
              "new": 5,
              "text": "export async function placeHold(db: Db, clock: Clock, slotId: string, guestId: string) {"
            },
            {
              "kind": "add",
              "new": 6,
              "text": "  const hold = await db.hold.create({"
            },
            {
              "kind": "add",
              "new": 7,
              "text": "    data: { slotId, guestId, expiresAt: addMinutes(clock.now(), HOLD_MINUTES) },"
            },
            {
              "kind": "add",
              "new": 8,
              "text": "  });"
            },
            {
              "kind": "add",
              "new": 9,
              "text": "  setTimeout(() => releaseHold(db, hold.id), HOLD_MINUTES * 60_000);"
            },
            {
              "kind": "add",
              "new": 10,
              "text": "  return hold;"
            },
            {
              "kind": "add",
              "new": 11,
              "text": "}"
