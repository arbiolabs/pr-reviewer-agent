              "text": "export async function cancelHold(db: Db, payments: Payments, holdId: string) {"
            },
            {
              "kind": "add",
              "new": 18,
              "text": "  const hold = await db.hold.findUniqueOrThrow({ where: { id: holdId }, include: { deposit: true } });"
            },
            {
              "kind": "add",
