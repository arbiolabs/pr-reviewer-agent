{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pr-review/protocol/v1/client-message.json",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "type",
        "requestId",
        "protocolVersion",
        "client",
        "capabilities"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "protocolVersion": {
          "type": "integer",
          "description": "any integer, so a mismatch is parseable and answered with PROTOCOL_MISMATCH"
        },
        "client": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "requestId"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "snapshot.get"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "requestId",
        "streamEpoch",
        "afterSequence"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "resume"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "streamEpoch": {
          "type": "string",
          "minLength": 1
        },
        "afterSequence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "requestId",
        "prId",
        "baseSha",
        "headSha"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "diff.get"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "prId": {
          "type": "string",
          "minLength": 1
        },
        "baseSha": {
          "type": "string",
          "minLength": 1
        },
        "headSha": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string"
        },
        "cursor": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "requestId",
        "findingId"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "finding.get"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "findingId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "requestId",
        "runId"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "publication.get"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "requestId"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "settings.get"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "requestId",
        "by"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "usage.get"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "by": {
          "enum": [
            "day",
            "week",
            "month"
          ]
        },
        "periods": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400,
          "description": "how many buckets up to the current one; 14 days, 12 weeks or 12 months when absent"
        },
        "group": {
          "enum": [
            "time",
            "repo",
            "author",
            "pr"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "type",
        "requestId",
        "limit"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "timeline.get"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "prId": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "findingId": {
          "type": "string",
          "minLength": 1
        },
        "beforeSequence": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "const": "review.add"
            },
            "params": {
              "type": "object",
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "description": "a GitHub pull request URL or owner/repo#N"
                }
              },
              "additionalProperties": false
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "const": "review.start"
            },
            "params": {
              "type": "object",
              "required": [
                "prId",
                "expectedHeadSha"
              ],
              "properties": {
                "prId": {
                  "type": "string",
                  "minLength": 1
                },
                "expectedHeadSha": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "const": "review.again"
            },
            "params": {
              "type": "object",
              "required": [
                "prId",
                "expectedHeadSha"
              ],
              "properties": {
                "prId": {
                  "type": "string",
                  "minLength": 1
                },
                "expectedHeadSha": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "const": "review.cancel"
            },
            "params": {
              "type": "object",
              "required": [
                "runId"
              ],
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "const": "review.retry"
            },
            "params": {
              "type": "object",
              "required": [
                "runId"
              ],
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "const": "review.publish"
            },
            "params": {
              "type": "object",
              "required": [
                "runId",
                "previewId",
                "expectedHeadSha"
              ],
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1
                },
                "previewId": {
                  "type": "string",
                  "minLength": 1
                },
                "expectedHeadSha": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "const": "account.select"
            },
            "params": {
              "type": "object",
              "required": [
                "accountId"
              ],
              "properties": {
                "accountId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "const": "pr.archive"
            },
            "params": {
              "type": "object",
              "required": [
                "prId"
              ],
              "properties": {
                "prId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "const": "pr.unarchive"
            },
            "params": {
              "type": "object",
              "required": [
                "prId"
              ],
              "properties": {
                "prId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "const": "settings.set"
            },
            "params": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "description": "one of settings.models; saved as models.default in the daemon's config and used for reviews started after it"
                },
                "summaryTemplate": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 4000
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "saved as review.summary_template and used for review bodies prepared after it; null or empty restores the default"
                },
                "autoReview": {
                  "type": "object",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "intervalMinutes": {
                      "anyOf": [
                        {
                          "type": "number",
                          "const": 5
                        },
                        {
                          "type": "number",
                          "const": 15
                        },
                        {
                          "type": "number",
                          "const": 30
                        }
                      ]
                    },
                    "includeTeamRequests": {
                      "type": "boolean"
                    },
                    "repos": {
                      "type": "object",
                      "properties": {
                        "include": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[\\w.-]+/[\\w.-]+$",
                            "maxLength": 200,
                            "description": "owner/name"
                          },
                          "maxItems": 200
                        },
                        "exclude": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "^[\\w.-]+/[\\w.-]+$",
                            "maxLength": 200,
                            "description": "owner/name"
                          },
                          "maxItems": 200
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false,
                  "description": "saved under review.auto_review; only the fields given change"
                }
              },
              "additionalProperties": false
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "const": "daemon.stop"
            },
            "params": {
              "type": "object",
              "required": [
                "pauseReviews"
              ],
              "properties": {
                "pauseReviews": {
                  "type": "boolean",
                  "description": "stop even while reviews run: they pause and resume on the next engine start; without it a running review makes the stop CONFLICT"
                }
              },
              "additionalProperties": false
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    }
  ]
}
