        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "const": "review.cancel"
            },
            "params": {
              "type": "object",
              "required": [
                "runId"
              ],
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "const": "review.retry"
            },
            "params": {
              "type": "object",
              "required": [
                "runId"
              ],
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "const": "review.publish"
            },
            "params": {
              "type": "object",
              "required": [
                "runId",
                "previewId",
                "expectedHeadSha"
              ],
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1
                },
                "previewId": {
                  "type": "string",
                  "minLength": 1
                },
                "expectedHeadSha": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "idempotencyKey": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "const": "account.select"
            },
            "params": {
              "type": "object",
              "required": [
                "accountId"
              ],
              "properties": {
                "accountId": {
                  "type": "string",
                  "minLength": 1
