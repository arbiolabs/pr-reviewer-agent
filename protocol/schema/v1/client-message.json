          "type": "object",
          "required": [
            "type",
            "requestId",
            "command",
            "params",
            "idempotencyKey"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "command"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
