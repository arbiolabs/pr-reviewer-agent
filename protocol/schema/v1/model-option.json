{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pr-review/protocol/v1/model-option.json",
  "type": "object",
  "required": [
    "ref",
    "provider",
    "name",
    "contextWindow",
    "authSource",
    "preferred"
  ],
  "properties": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "description": "provider/id, what settings.set names"
    },
    "provider": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "contextWindow": {
      "type": "integer",
      "minimum": 0
    },
    "authSource": {
      "type": "string",
      "description": "where the provider's credential comes from, as pi-ai reports it; never the credential"
    },
    "preferred": {
      "type": "boolean",
      "description": "matched by models.preferred in the config; preferred models are listed first"
    }
  }
}
